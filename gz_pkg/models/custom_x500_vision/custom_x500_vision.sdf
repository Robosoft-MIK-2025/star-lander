<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.7'>
  <model name='custom_x500_vision'>
    <!-- source base x500 -->
    <include merge='true'>
      <uri>x500</uri>
    </include>
    
    <!-- Вставляем камеру здесь: Новый link с сенсором -->
    <!-- TODO: <link name="camera_link"> or <link name="base_link"> -->
    <link name="vision_link">
      <pose>0 0 0.19 0 0 0</pose>  <!-- Положение камеры на дроне: спереди, вниз (x y z roll pitch yaw). Подстрой под себя, напр. pitch=1.57 для 90° вниз -->
      <inertial>
        <mass>0.01</mass>  <!-- Маленькая масса для камеры -->
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="vision_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>  <!-- Маленький бокс для визуализации камеры -->
          </box>
        </geometry>
        <material>
          <diffuse>0 0 1 1</diffuse>  <!-- Синий цвет для видимости в Gazebo -->
        </material>
      </visual>
      <collision name="vision_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.02</size>
          </box>
        </geometry>
      </collision>
      <!-- TODO: name="camera" name="vision" ??? -->
      <sensor name="vision" type="camera">
        <pose>0 0 0 0 1.57 0</pose>  <!-- Поза относительно link -->
        <camera>
          <horizontal_fov>1.047</horizontal_fov>  <!-- FOV ~60° -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>  <!-- Опционально: шум -->
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <distortion>
            <k1>0.0</k1>  <!-- Добавь дисторсию, если нужно симулировать реальную камеру -->
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
          </distortion>
        </camera>


        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        
        <!-- <topic>image</topic> -->


        <!-- Стандартный плагин камеры - [not supported] -->
        <!-- <plugin filename="gz-sim-camera-system" name="gz::sim::systems::Camera"></plugin>   -->

        <!-- Правильный плагин для публикации в ROS2 -->
        <!-- <plugin filename="libros_gz_sim.so" name="ros_gz_sim::ROS2Camera">
          <ros>
            <namespace>custom_x500_vision</namespace> 
            <topic>image_raw</topic>
            <camera_info_topic>camera_info</camera_info_topic>
            <frame_name>vision_link</frame_name>
          </ros>
        </plugin> -->

      </sensor>
    </link>
    
    <!-- Прикрепляем камеру к base_link дрона (fixed joint, чтобы не двигалась относительно) -->
    <!-- TODO: child: camera_link -->
    <!-- base_link — основной link дрона из x500 -->
    <joint name="vision_joint" type="fixed">
      <parent>base_link</parent>  
      <child>vision_link</child>
    </joint>

  
    <!-- <plugin filename="libgz-sim8-sensors-system.so" name="gz::sim::systems::Sensors"/> -->

    <!-- source odometry file -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>