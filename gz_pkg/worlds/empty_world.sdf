<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="default">
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
    </scene>

    <!-- Физика -->
    <physics type="ode">
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>


    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Освещение для камеры (default свет слабый) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>0 0 10 0 0 0</pose>
        <projection_type>perspective</projection_type>
      </camera>
      <light name="user_light" type="directional" cast_shadows="true">
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
          <range>1000</range>
          <linear>0.01</linear>
          <constant>0.9</constant>
          <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
      </light>
    </gui>


    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- Important -->
    <!--pose: Укажи позицию тега: x y z roll pitch yaw -->
    <!--name: Опционально, имя экземпляра -->
    <include>
      <uri>model://apriltag_tag36h11_0</uri>
      <pose>0 0 0 0 0 3.1416</pose>  
      <name>apriltag_0</name>   
    </include>

    <!-- Important -->
    <!-- Дрон custom_x500_vision (спавн в воздухе над тегом) -->
    <!-- x=0 y=0 z=1m, orientation 0 -->
    <include>
      <uri>model://custom_x500_vision</uri>
      <pose>0 0 2.0 0 0 0</pose>  
      <name>custom_x500_vision</name>
    </include>


  </world>
</sdf>
